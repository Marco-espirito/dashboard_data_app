DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app
DJANGO_TIME_ZONE=Europe/Paris
# Facultatif pour un proxy local sans HTTPS (Docker Compose le configure déjà) :
# DJANGO_SECURE_SSL_REDIRECT=False
# DJANGO_SESSION_COOKIE_SECURE=False
# DJANGO_CSRF_COOKIE_SECURE=False
# En production, utilisez une base PostgreSQL persistante :
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
